# ─── Database ───────────────────────────────────────────────────────────────
# Em produção no Railway, use o formato postgresql://user:pass@host:port/dbname
DATABASE_URL="postgresql://postgres:password@localhost:5432/medgrowth"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Usado pelo BullMQ para background jobs
REDIS_URL="redis://localhost:6379"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Encryption (AES-256, 32 chars) ─────────────────────────────────────────
# Chave essencial para criptografar tokens Meta/Google no banco
ENCRYPTION_KEY="12345678901234567890123456789012"

# ─── API (Backend) ──────────────────────────────────────────────────────────
PORT=3001
API_URL="http://localhost:3001"
ALLOWED_ORIGINS="http://localhost:3000"

# ─── NextJS (Web Frontend) ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── Meta Ads OAuth ──────────────────────────────────────────────────────────
# Obtenha em developers.facebook.com
META_APP_ID=""
META_APP_SECRET=""
META_API_VERSION="v19.0"
META_REDIRECT_URI="http://localhost:3001/ads/meta/callback"

# ─── Google Ads OAuth ────────────────────────────────────────────────────────
# Obtenha em console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_DEVELOPER_TOKEN=""
GOOGLE_REDIRECT_URI="http://localhost:3001/ads/google/callback"

# ─── Sentry (Opcional) ──────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ─── Node Config ────────────────────────────────────────────────────────────
NODE_ENV="development"
