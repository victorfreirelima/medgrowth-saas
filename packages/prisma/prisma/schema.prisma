// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  COMMERCIAL
  MANAGER
}

enum LeadStatus {
  NOVO
  EM_CONTATO
  QUALIFICADO
  AGENDADO
  COMPARECEU
  FECHADO
  PERDIDO
}

enum LeadChannel {
  META
  GOOGLE
  ORGANIC
  REFERRAL
  OTHER
}

enum LeadSource {
  META_LEAD_ADS
  WEBSITE
  WHATSAPP
  MANUAL
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum AdChannel {
  META
  GOOGLE
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  ERROR
  DISCONNECTED
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum IntegrationProvider {
  META
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(COMMERCIAL)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clients   UserClient[]
  leads     Lead[]       @relation("AssignedLeads")
  notes     LeadNote[]
  auditLogs AuditLog[]

  @@map("users")
}

model Client {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  logoUrl   String?
  status    ClientStatus @default(ACTIVE)
  specialty String?
  city      String?
  notes     String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users        UserClient[]
  leads        Lead[]
  appointments Appointment[]
  connections  AdAccountConnection[]
  snapshots    CampaignSnapshotDaily[]
  auditLogs    AuditLog[]
  integrations ClientIntegration[]

  @@map("clients")
}

model UserClient {
  userId   String
  clientId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([userId, clientId])
  @@index([clientId])
  @@map("user_clients")
}

model Lead {
  id              String      @id @default(uuid())
  clientId        String
  name            String
  phone           String?
  email           String?
  origin          String?
  channel         LeadChannel @default(OTHER)
  source          LeadSource?
  campaignId      String?
  campaignName    String?
  adsetId         String?
  adId            String?
  status          LeadStatus  @default(NOVO)
  statusUpdatedAt DateTime    @default(now())
  firstContactAt  DateTime?
  appointmentDate DateTime?
  revenue         Float?
  lostReason      String?
  assignedToId    String?
  observations    String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  gclid           String?
  fbclid          String?
  wbraid          String?
  gbraid          String?
  providerLeadId  String?     @unique
  rawPayload      Json?
  formName        String?
  pageUrl         String?
  message         String?
  deviceType      String?
  timezone        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  client       Client        @relation(fields: [clientId], references: [id])
  assignedTo   User?         @relation("AssignedLeads", fields: [assignedToId], references: [id])
  notes        LeadNote[]
  appointments Appointment[]

  @@index([clientId])
  @@index([status])
  @@index([channel])
  @@index([source])
  @@index([createdAt])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("lead_notes")
}

model Appointment {
  id        String            @id @default(uuid())
  clientId  String
  leadId    String
  dateTime  DateTime
  procedure String?
  status    AppointmentStatus @default(CONFIRMED)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead   Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([leadId])
  @@index([dateTime])
  @@map("appointments")
}

model ClientIntegration {
  id            String              @id @default(uuid())
  clientId      String
  provider      IntegrationProvider
  enabled       Boolean             @default(false)
  pageId        String?
  formId        String?
  pageName      String?
  formName      String?
  webhookActive Boolean             @default(false)
  lastLeadAt    DateTime?
  apiKey        String              @unique @default(uuid())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, provider])
  @@index([clientId])
  @@map("client_integrations")
}

model AdAccountConnection {
  id                    String           @id @default(uuid())
  clientId              String
  channel               AdChannel
  accountId             String
  accountName           String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  status                ConnectionStatus @default(ACTIVE)
  lastSyncAt            DateTime?
  errorMessage          String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  client    Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  snapshots CampaignSnapshotDaily[]

  @@unique([clientId, channel, accountId])
  @@map("ad_account_connections")
}

model CampaignSnapshotDaily {
  id           String    @id @default(uuid())
  clientId     String
  connectionId String
  date         DateTime  @db.Date
  campaignId   String
  campaignName String
  adsetId      String?
  adsetName    String?
  channel      AdChannel
  spend        Float     @default(0)
  impressions  Int       @default(0)
  clicks       Int       @default(0)
  ctr          Float     @default(0)
  cpc          Float     @default(0)
  cpm          Float     @default(0)
  leads        Int       @default(0)
  conversions  Int       @default(0)
  reach        Int       @default(0)
  frequency    Float     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client     Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  connection AdAccountConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, date, campaignId, adsetId])
  @@index([clientId])
  @@index([connectionId])
  @@index([date])
  @@index([channel])
  @@map("campaign_snapshots_daily")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  clientId  String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@index([userId])
  @@index([clientId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
