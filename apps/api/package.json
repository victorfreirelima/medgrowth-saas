{
    "name": "api",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "nest build",
        "dev": "nest start --watch",
        "start": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:e2e": "jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@fastify/static": "7.0.3",
        "@medgrowth/prisma": "workspace:*",
        "@nestjs/bull": "^10.1.1",
        "@nestjs/bullmq": "^11.0.4",
        "@nestjs/common": "^10.3.7",
        "@nestjs/config": "^3.2.1",
        "@nestjs/core": "^10.3.7",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/mapped-types": "^2.0.5",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-fastify": "^10.3.7",
        "@nestjs/swagger": "^7.3.1",
        "@nestjs/throttler": "^5.1.2",
        "@prisma/client": "^5.12.0",
        "@sentry/nestjs": "^10.39.0",
        "@sentry/profiling-node": "^10.39.0",
        "axios": "^1.13.5",
        "bcryptjs": "^2.4.3",
        "bull": "^4.12.4",
        "bullmq": "^5.69.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.3.2",
        "@nestjs/schematics": "^10.1.1",
        "@nestjs/testing": "^10.3.7",
        "@types/axios": "^0.14.4",
        "@types/bcryptjs": "^2.4.6",
        "@types/bull": "^4.10.0",
        "@types/express": "^5.0.6",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.12.7",
        "@types/passport-jwt": "^4.0.1",
        "jest": "^29.7.0",
        "supertest": "^7.0.0",
        "ts-jest": "^29.1.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.5"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^@medgrowth/prisma(.*)$": "<rootDir>/../../packages/prisma/node_modules/@prisma/client$1"
        }
    }
}